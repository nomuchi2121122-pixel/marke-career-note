---
import { SITE } from '../data/site';
import '../styles.css';
import Sidebar from '../components/Sidebar.astro';
import { CATEGORIES } from '../data/categories';
import { getCollection } from 'astro:content';
interface Props {
  title: string;
  description: string;
  showPr?: boolean;
  /** 記事ページなら 'article'（OGPの種類が変わる） */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** ページ固有の構造化データ（JSON-LD）。サイト共通分は自動で入る */
  jsonLd?: Record<string, unknown>[];
  /** OGP画像（記事のアイキャッチ）。なければサイト共通画像 */
  image?: string;
  /** サイドバーを出すか */
  sidebar?: boolean;
}
const { title, description, showPr = false, type = 'website', publishedTime, modifiedTime, jsonLd = [], image, sidebar = true } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title}｜${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL('/', Astro.site).href;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;

// サイト共通の構造化データ：サイト名と運営者
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: SITE.name,
    url: siteUrl,
    inLanguage: 'ja',
    publisher: { '@id': `${siteUrl}#operator` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}#operator`,
    name: SITE.operatorName,
    url: new URL('/about/', Astro.site).href,
    description: SITE.operatorProfile,
    sameAs: [SITE.threadsUrl],
  },
];
const allJsonLd = [...siteJsonLd, ...jsonLd];
// 記事があるカテゴリだけメニューに出す
const published = await getCollection('articles', ({ data }) => !data.draft);
const navCategories = CATEGORIES.filter((c) => published.some((p) => p.data.category === c.name));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(allJsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">M</span>{SITE.name}</a>
        <p class="header-tagline">マーケ職の転職・学び直し・補助金の実用ノート</p>
      </div>
      <nav class="global-nav" aria-label="メインメニュー">
        <div class="wrap">
          <a href="/">ホーム</a>
          {navCategories.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}
          <a href="/articles/">記事一覧</a>
          <a href="/about/">運営者情報</a>
        </div>
      </nav>
    </header>
    <div class:list={['wrap', 'page', { 'has-sidebar': sidebar }]}>
      <main class="content">
        {showPr && (
          <p class="pr-notice">【PR】本記事にはプロモーション（広告）が含まれています。紹介するサービスの申込みにより、当サイトが報酬を受け取る場合があります。</p>
        )}
        <slot />
      </main>
      {sidebar && <Sidebar />}
    </div>
    <footer class="site-footer">
      <div class="wrap">
        <nav>
          <a href="/about/">運営者情報</a>
          <a href="/ad-policy/">広告掲載ポリシー</a>
          <a href="/privacy/">プライバシーポリシー</a>
          <a href="/contact/">お問い合わせ</a>
          <a href={SITE.threadsUrl} target="_blank" rel="noopener me">Threads</a>
        </nav>
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
