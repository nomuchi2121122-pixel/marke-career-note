---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../data/site';
import { categorySlug } from '../../data/categories';
import ArticleCard from '../../components/ArticleCard.astro';
export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const modified = d.updatedDate ?? d.pubDate;
const url = new URL(`/articles/${post.id}/`, Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const fmt = (date: Date) => date.toLocaleDateString('ja-JP');

// 目次：h2だけを並べる（h3まで入れると長くなりすぎるため）
const toc = headings.filter((h) => h.depth === 2);

// 関連記事：同じカテゴリを優先し、残りは新しい順で最大3件
const others = all.filter((p) => p.id !== post.id);
const related = [
  ...others.filter((p) => p.data.category === d.category),
  ...others.filter((p) => p.data.category !== d.category).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
].slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    mainEntityOfPage: url,
    image: new URL(d.image ?? '/og-default.png', Astro.site).href,
    inLanguage: 'ja',
    author: { '@id': `${siteUrl}#operator` },
    publisher: { '@id': `${siteUrl}#operator` },
    isPartOf: { '@id': `${siteUrl}#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: '記事一覧', item: new URL('/articles/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} showPr={d.hasAffiliate} type="article" publishedTime={d.pubDate} modifiedTime={modified} jsonLd={jsonLd} image={d.image}>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">ホーム</a> › <a href={`/category/${categorySlug(d.category)}/`}>{d.category}</a>
  </nav>
  <article>
    <header class="article-header">
      <a class="badge" href={`/category/${categorySlug(d.category)}/`}>{d.category}</a>
      <h1>{d.title}</h1>
      <p class="meta">
        公開 <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
        {d.updatedDate && <>　更新 <time datetime={d.updatedDate.toISOString()}>{fmt(d.updatedDate)}</time></>}
        　執筆 <a href="/about/">{SITE.operatorName}</a>
      </p>
    </header>
    {d.image && (
      <figure class="eyecatch">
        <img src={d.image} alt={d.imageAlt} width="1200" height="675" fetchpriority="high" decoding="async" />
      </figure>
    )}
    {d.points.length > 0 && (
      <section class="points">
        <p class="points-title">この記事のポイント</p>
        <ul>{d.points.map((pt) => <li>{pt}</li>)}</ul>
      </section>
    )}
    {toc.length >= 3 && (
      <nav class="toc" aria-label="目次">
        <p class="toc-title">目次</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <Content />
    {d.sources.length > 0 && (
      <section class="sources">
        <h2>参考にした公式情報</h2>
        <ul>{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul>
      </section>
    )}
    <aside class="author-box">
      <div class="avatar" aria-hidden="true">N</div>
      <p class="author-name">この記事を書いた人：<a href="/about/">{SITE.operatorName}</a></p>
      <p>{SITE.operatorProfile}</p>
      <p><a href={SITE.threadsUrl} target="_blank" rel="noopener me">Threads（@nomryo_marketer）</a></p>
    </aside>
  </article>
  {related.length > 0 && (
    <section class="related">
      <h2>あわせて読みたい</h2>
      <ul class="card-grid">
        {related.map((p) => <ArticleCard post={p} />)}
      </ul>
    </section>
  )}
</Base>
